{
  "version": 2,
  "schema": {
    "type": "object",
    "required": ["messages", "id"],
    "properties": {
      "id": {"type": "string"},
      "messages": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": {"enum": ["user", "assistant"]},
            "content": {"type": "string", "maxLength": 4000}
          }
        }
      }
    }
  }
}
